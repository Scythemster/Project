# EventForge Backend Environment
# Copy to .env and fill in real values. NEVER commit .env.

# Which provider to use by default: openai | gemini | anthropic | custom
AI_PROVIDER=openai

# Generation defaults (can be overridden per request from the UI)
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=1024

# ── OpenAI ─────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional: point at any OpenAI-compatible gateway
OPENAI_BASE_URL=

# ── Google Gemini ──────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ── Anthropic (Claude) ─────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# ── Custom OpenAI-compatible endpoint ──────────────────
# e.g. Ollama (http://localhost:11434/v1), LM Studio, OpenRouter, Together
CUSTOM_API_KEY=
CUSTOM_MODEL=llama3.1
CUSTOM_BASE_URL=http://localhost:11434/v1

# ── Server ─────────────────────────────────────────────
PORT=3001
CORS_ORIGIN=http://localhost:5173

# NOTE: If no key is configured for the selected provider, the app runs in
# fallback mode and returns honest, deterministic content built from user input.